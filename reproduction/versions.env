# Pinned versions used in the paper experiments. Sourced by the build scripts.

# VHAPE with the sma and vpa heuristics (this repository, branch "paper").
VHAPE_REPO=https://github.com/ufcg-lsd/vhape-recommender.git
VHAPE_BRANCH=paper
VHAPE_BASE_COMMIT=89eb18045      # master the branch started from (VHAPE 1.3.0)

# Tiny Autoscalers (Zhao and Uta, CCGrid 2022): serverless-recommender, copied into tiny/serverless-recommender.
TINY_REPO=https://github.com/ZhaoNeil/On-Demand-Resizing.git
TINY_COMMIT=f3a15a34

# VPA release that Tiny Autoscalers replaces pkg/recommender in.
VPA_BASE_REPO=https://github.com/kubernetes/autoscaler.git
VPA_BASE_COMMIT=b03f204804c9f27036cd96d105e4834b63b14052   # 2021-02-22, PR #3769
VPA_BASE_SHALLOW_SINCE=2021-02-15

# Upstream VPA used as baseline for the vpa heuristic.
VPA_UPSTREAM_VERSION=1.6.0

# Environment of the experiments.
GO_VERSION=1.27.3
MINIKUBE_VERSION=v1.38.1
KUBERNETES_VERSION=v1.35.1
METRICS_SERVER_RESOLUTION=15s
